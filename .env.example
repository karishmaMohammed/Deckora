# anthropic | openai. If unset, inferred from which key is present.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5

ANTHROPIC_API_KEY=

# For LLM_PROVIDER=openai (default model: gpt-4o-mini)
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (Azure, OpenRouter, local).
# LLM_BASE_URL=

PORT=3001
